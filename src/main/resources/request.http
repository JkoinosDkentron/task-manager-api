
### TASK MANAGER API
### Manual tests using IntelliJ HTTP Client

@baseUrl = http://localhost:8080
@missingId = 999999

### ==========================================================
### 01 - CREATE TASK (201)
### Run this request FIRST
### ==========================================================

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Prepare technical interview",
  "description": "Review Java, Spring Boot and REST",
  "dueDate": "2099-12-15"
}

> {%
    client.test("Task created successfully", function() {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.id != null, "Missing task ID");
        client.assert(response.body.status === "PENDING", "Expected PENDING");
    });

    client.global.set("createdTaskId", response.body.id);
%}

### ==========================================================
### 02 - GET TASK BY ID (200)
### ==========================================================

GET {{baseUrl}}/api/tasks/{{createdTaskId}}
Accept: application/json

> {%
    client.test("Task retrieved", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.title === "Prepare technical interview");
    });
%}

### ==========================================================
### 03 - LIST ALL TASKS (200)
### ==========================================================

GET {{baseUrl}}/api/tasks
Accept: application/json

> {%
    client.test("Task list returned", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body), "Expected JSON array");
    });
%}

### ==========================================================
### 04 - FILTER BY PENDING STATUS (200)
### ==========================================================

GET {{baseUrl}}/api/tasks?status=PENDING
Accept: application/json

### ==========================================================
### 05 - CREATE SECOND TASK (201)
### ==========================================================

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Complete Java assessment",
  "description": "Implement all REST endpoints",
  "status": "COMPLETED"
}

> {%
    client.test("Second task created", function() {
        client.assert(response.status === 201, "Expected HTTP 201");
        client.assert(response.body.status === "COMPLETED");
    });
    client.global.set("secondTaskId", response.body.id);
%}

### ==========================================================
### 06 - FILTER BY COMPLETED STATUS (200)
### ==========================================================

GET {{baseUrl}}/api/tasks?status=COMPLETED
Accept: application/json

### ==========================================================
### 07 - FULL UPDATE USING PUT (200)
### ==========================================================

PUT {{baseUrl}}/api/tasks/{{createdTaskId}}
Content-Type: application/json

{
  "title": "Prepare final interview",
  "description": "Review controllers services and repositories",
  "status": "IN_PROGRESS",
  "dueDate": "2099-12-20"
}

> {%
    client.test("Task updated", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "IN_PROGRESS");
        client.assert(response.body.title === "Prepare final interview");
    });
%}

### ==========================================================
### 08 - UPDATE ONLY STATUS USING PATCH (200)
### ==========================================================

PATCH {{baseUrl}}/api/tasks/{{createdTaskId}}/status
Content-Type: application/json

{
  "status": "COMPLETED"
}

> {%
    client.test("Status updated", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "COMPLETED");
        client.assert(response.body.title === "Prepare final interview");
    });
%}

### ==========================================================
### 09 - VERIFY PERSISTED UPDATE (200)
### ==========================================================

GET {{baseUrl}}/api/tasks/{{createdTaskId}}
Accept: application/json

> {%
    client.test("Update persisted", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.status === "COMPLETED");
    });
%}

### ==========================================================
### NEGATIVE TEST SCENARIOS
### ==========================================================

### 10 - TITLE TOO SHORT (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "AB"
}

> {%
    client.test("Short title rejected", function() {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.fields.title != null, "Missing title error");
    });
%}

### 11 - BLANK TITLE (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "   "
}

### 12 - TITLE MISSING (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "description": "No title provided"
}

### 13 - NULL TITLE (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": null
}

### 14 - PAST DUE DATE (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Invalid deadline",
  "dueDate": "2020-01-01"
}

> {%
    client.test("Past due date rejected", function() {
        client.assert(response.status === 400, "Expected HTTP 400");
        client.assert(response.body.fields.dueDate != null);
    });
%}

### 15 - INVALID STATUS ON CREATION (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Invalid status test",
  "status": "CANCELLED"
}

### 16 - INVALID STATUS FILTER (400)

GET {{baseUrl}}/api/tasks?status=INVALID
Accept: application/json

### 17 - NULL STATUS IN PATCH (400)

PATCH {{baseUrl}}/api/tasks/{{createdTaskId}}/status
Content-Type: application/json

{
  "status": null
}

### 18 - INVALID STATUS IN PATCH (400)

PATCH {{baseUrl}}/api/tasks/{{createdTaskId}}/status
Content-Type: application/json

{
  "status": "UNKNOWN"
}

### 19 - INVALID PUT TITLE (400)

PUT {{baseUrl}}/api/tasks/{{createdTaskId}}
Content-Type: application/json

{
  "title": "AB",
  "description": "Invalid update",
  "status": "PENDING"
}

### 20 - MISSING STATUS IN PUT (400)

PUT {{baseUrl}}/api/tasks/{{createdTaskId}}
Content-Type: application/json

{
  "title": "Task without update status"
}

### 21 - MALFORMED JSON (400)

POST {{baseUrl}}/api/tasks
Content-Type: application/json

{
  "title": "Malformed JSON"

### ==========================================================
### NOT FOUND SCENARIOS
### ==========================================================

### 22 - GET UNKNOWN TASK (404)

GET {{baseUrl}}/api/tasks/{{missingId}}
Accept: application/json

> {%
    client.test("Missing task returns 404", function() {
        client.assert(response.status === 404, "Expected HTTP 404");
        client.assert(response.body.status === 404);
    });
%}

### 23 - PUT UNKNOWN TASK (404)

PUT {{baseUrl}}/api/tasks/{{missingId}}
Content-Type: application/json

{
  "title": "Unknown task update",
  "description": "Should fail",
  "status": "PENDING"
}

### 24 - PATCH UNKNOWN TASK (404)

PATCH {{baseUrl}}/api/tasks/{{missingId}}/status
Content-Type: application/json

{
  "status": "COMPLETED"
}

### 25 - DELETE UNKNOWN TASK (404)

DELETE {{baseUrl}}/api/tasks/{{missingId}}

### ==========================================================
### DELETE TESTS - EXECUTE LAST
### ==========================================================

### 26 - DELETE CREATED TASK (204)

DELETE {{baseUrl}}/api/tasks/{{createdTaskId}}

> {%
    client.test("Task deleted", function() {
        client.assert(response.status === 204, "Expected HTTP 204");
    });
%}

### 27 - VERIFY DELETED TASK RETURNS 404

GET {{baseUrl}}/api/tasks/{{createdTaskId}}
Accept: application/json

> {%
    client.test("Deleted task is not found", function() {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

### 28 - DELETE SECOND TASK (204)

DELETE {{baseUrl}}/api/tasks/{{secondTaskId}}

### 29 - FINAL LIST (200)

GET {{baseUrl}}/api/tasks
Accept: application/json
